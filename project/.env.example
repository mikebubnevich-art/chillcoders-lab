# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored and is loaded automatically by tools/model_matrix.py.
# For a normal harness run, export them in the shell instead:
#   set -a; source .env.local; set +a
LLM_BASE_URL=https://<proxy-host>/v1
LLM_API_KEY=<key>

# Optional tuning (defaults shown):
# MODEL=qwen3.8-27b-noreason
# MODEL_CODING=qwen3.8-27b  # stronger model for coding tasks only
# CODING_STRATEGY=fallback  # fallback: base first, strong model only on failure
#                           # always: send every coding task to MODEL_CODING
# LLM_CONCURRENCY=5      # simultaneous HTTP requests; auto-lowered on 429
# LLM_MIN_CONCURRENCY=1  # never lower the adaptive limit below this
# LLM_ATTEMPTS=4         # retries per call (429/5xx/timeout)
# REASON_MULT=4          # completion cap multiplier for reasoning models
# USE_OJIWEN=1           # 0 = force raw urllib (A/B)
